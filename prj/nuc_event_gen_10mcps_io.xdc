set_property PACKAGE_PIN B13 [get_ports {cfg_rdata[8]}]
set_property PACKAGE_PIN B15 [get_ports {cfg_rdata[9]}]
set_property PACKAGE_PIN B16 [get_ports {cfg_rdata[10]}]
set_property PACKAGE_PIN B17 [get_ports {cfg_rdata[11]}]
set_property PACKAGE_PIN B18 [get_ports {cfg_rdata[12]}]
set_property PACKAGE_PIN B20 [get_ports {cfg_rdata[13]}]
set_property PACKAGE_PIN B21 [get_ports {cfg_rdata[14]}]
set_property PACKAGE_PIN B22 [get_ports {cfg_rdata[15]}]
set_property PACKAGE_PIN C13 [get_ports {cfg_rdata[16]}]
set_property PACKAGE_PIN C14 [get_ports {cfg_rdata[17]}]
set_property PACKAGE_PIN C15 [get_ports {cfg_rdata[18]}]
set_property PACKAGE_PIN C17 [get_ports {cfg_rdata[19]}]
set_property PACKAGE_PIN C18 [get_ports {cfg_rdata[20]}]
set_property PACKAGE_PIN C19 [get_ports {cfg_rdata[21]}]
set_property PACKAGE_PIN C20 [get_ports {cfg_rdata[22]}]
set_property PACKAGE_PIN C22 [get_ports {cfg_rdata[23]}]
set_property PACKAGE_PIN D14 [get_ports {cfg_rdata[24]}]
