# ICDF amplitude LUT write port, Bank34
set_property PACKAGE_PIN AA1 [get_ports amp_lut_we]
set_property PACKAGE_PIN AA3 [get_ports {amp_lut_addr[0]}]
set_property PACKAGE_PIN AA4 [get_ports {amp_lut_addr[1]}]
