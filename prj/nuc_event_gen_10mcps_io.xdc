set_property PACKAGE_PIN AA6 [get_ports {amp_lut_addr[3]}]
set_property PACKAGE_PIN AA8 [get_ports {amp_lut_addr[4]}]
set_property PACKAGE_PIN AB1 [get_ports {amp_lut_addr[5]}]
set_property PACKAGE_PIN AB2 [get_ports {amp_lut_addr[6]}]
set_property PACKAGE_PIN AB3 [get_ports {amp_lut_addr[7]}]
